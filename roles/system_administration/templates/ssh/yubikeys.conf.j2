# Managed by Ansible (workstation repository).
#
# Offer the passphrase-protected workstation key first, followed by the FIDO2
# key belonging to whichever enrolled YubiKey is connected. Included from the
# top of ~/.ssh/config, so the identities below are offered ahead of those
# listed there (ssh ignores the duplicate workstation key).
#
# The workstation key's passphrase is stored in the GNOME login keyring and
# unlocked on login by gcr-ssh-agent. See docs/KEYRING.md.

Host *
    IdentityFile ~/.ssh/id-ed25519-workstation-2026-05-02
{% for yubikey in yubikeys %}

# {{ yubikey.name }}
Match exec "ykman list --serials 2>/dev/null | grep -qx {{ yubikey.serial }}"
    IdentityFile ~/.ssh/{{ yubikey.ssh_key }}
{% endfor %}
