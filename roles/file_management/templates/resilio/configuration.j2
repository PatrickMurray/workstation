{
  "device_name": "{{ resilio.device_name | default('workstation') }}",
  "listening_port": {{ resilio.service.network.listening_port | default(57037) }},

  "storage_path": "{{ resilio.service.library.directory }}",

  "pid_file": "{{ resilio.service.runtime.directory }}/{{ resilio.service.runtime.pid_filename }}",

  "use_upnp": true,

  "download_limit": 0,
  "upload_limit": 0,

  "directory_root": "{{ resilio.folders.directory }}",
  "directory_root_policy": "all",

  "shared_folders": [
{% set comma = joiner(",") %}
{% set workstation_type = workstation_type | default('default') %}
{% set folder_keys = resilio.folders.workstation_type_folders[workstation_type] %}
{# Resilio only supports discovery options per folder; apply global defaults to each #}
{% set discovery = resilio.folders.discovery | default({}) %}
{% for folder_key in folder_keys %}
    {% set folder = resilio.folders.definitions[folder_key] %}
    {{ comma() }}
    {
      "dir": "{{ resilio.folders.directory }}/{{ folder.name }}",
      "secret": "{{ folder.secret }}",
      "selective_sync": {{ folder.selective_sync | bool | lower }},
      "use_tracker": {{ folder.use_tracker | default(discovery.use_tracker | default(true)) | bool | lower }},
      "search_lan": {{ folder.search_lan | default(discovery.search_lan | default(true)) | bool | lower }},
      "use_relay_server": {{ folder.use_relay_server | default(discovery.use_relay_server | default(true)) | bool | lower }}
    }
{% endfor %}
  ],

  "folder_rescan_interval": 600
}
